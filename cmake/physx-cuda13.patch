+// CUDA 13 host stubs refer to these newer runtime entry points. PhysX
+// launches through the driver API, so the generated host stubs are unused.
+extern "C" cudaError_t CUDARTAPI __cudaGetKernel(cudaKernel_t* kernel, const void* function)
+{
+	*kernel = reinterpret_cast<cudaKernel_t>(const_cast<void*>(function));
+	return cudaSuccess;
+}
